{
  "name": "paylite-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "gen:api": "npm run gen:api:wallet && npm run gen:api:activity",
    "gen:api:wallet": "openapi-typescript http://localhost:8081/swagger/v1/swagger.json -o src/shared/api/generated/wallet.ts",
    "gen:api:activity": "openapi-typescript http://localhost:8082/swagger/v1/swagger.json -o src/shared/api/generated/activity.ts"
  },
  "dependencies": {
    "@microsoft/signalr": "^11.0.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.6"
  }
}
