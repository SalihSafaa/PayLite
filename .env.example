# Copy this file to .env and fill in real values. Never commit .env.

# SQL Server 'sa' password: 8+ characters with upper, lower, digit and symbol.
# Used only by SQL Server itself, the two migrators and dbsetup. The APIs never see it.
DB_PASSWORD=ChangeMe_Str0ng!

# Passwords of the least-privilege logins the APIs connect with (same complexity rules,
# and must not contain a single quote).
WALLET_DB_PASSWORD=ChangeMe_Wallet1!
ACTIVITY_DB_PASSWORD=ChangeMe_Activity1!

# JWT: the Wallet API signs tokens, the Activity Service validates them.
# Both services read these same values. Key: at least 32 characters.
JWT_KEY=replace-with-a-long-random-string-of-32-or-more-characters
JWT_ISSUER=PayLite
JWT_AUDIENCE=PayLite

# First admin account, created by the Wallet API at startup if no admin exists
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=ChangeMe_Admin1!

# Optional (defaults to Development; Swagger is only enabled in Development)
ASPNETCORE_ENVIRONMENT=Development
